<Window x:Class="NexusEQ.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NEXUS.EQ" Width="860" Height="760" MinWidth="760" MinHeight="680"
        Background="#05070D" FontFamily="Consolas" WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">

            <!-- Encabezado -->
            <Grid Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="NEXUS.EQ" Foreground="#00F0FF" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="DSP · WINDOWS · 10 BANDAS" Foreground="#6B7A99" FontSize="11"/>
                </StackPanel>
                <Button x:Name="PowerBtn" Width="68" Height="68" HorizontalAlignment="Right"
                        Content="ON" FontSize="16" FontWeight="Bold" Click="PowerBtn_Click"
                        Background="#12001F10" Foreground="#B6FF3B" BorderBrush="#B6FF3B" BorderThickness="2"/>
            </Grid>

            <!-- Estado de Equalizer APO -->
            <Border Background="#0B101B" BorderBrush="#1A2335" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <TextBlock x:Name="StatusText" Text="..." Foreground="#6B7A99" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Curva -->
            <Border Background="#0B101B" BorderBrush="#1A2335" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="CurveTitle" Text="RESPUESTA" Foreground="#6B7A99" FontSize="11" Margin="0,0,0,6"/>
                    <Canvas x:Name="CurveCanvas" Height="140" ClipToBounds="True" SizeChanged="CurveCanvas_SizeChanged"/>
                </StackPanel>
            </Border>

            <!-- Faders -->
            <Border Background="#0B101B" BorderBrush="#1A2335" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <UniformGrid x:Name="FaderGrid" Columns="10"/>
                    <TextBlock Text="Doble clic en una banda = 0 dB" Foreground="#6B7A99" FontSize="10" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Presets -->
            <WrapPanel x:Name="PresetPanel" Margin="0,0,0,12"/>

            <!-- Preamp / Bass / Auto -->
            <Border Background="#0B101B" BorderBrush="#1A2335" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="PREAMP" Foreground="#6B7A99" FontSize="11"/>
                        <TextBlock x:Name="PreampText" Text="+0.0 dB" Foreground="#00F0FF" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="PreampSlider" Minimum="-12" Maximum="6" TickFrequency="0.5"
                            IsSnapToTickEnabled="True" ValueChanged="PreampSlider_ValueChanged" Margin="0,2,0,10"/>
                    <Grid>
                        <TextBlock Text="BASS BOOST" Foreground="#6B7A99" FontSize="11"/>
                        <TextBlock x:Name="BassText" Text="0%" Foreground="#FF2BD6" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="BassSlider" Minimum="0" Maximum="1" ValueChanged="BassSlider_ValueChanged" Margin="0,2,0,10"/>
                    <CheckBox x:Name="AutoPreampCheck" Content="AUTO-PREAMP (resta el pico de boost)"
                              Foreground="#E6F1FF" Checked="AutoPreampCheck_Changed" Unchecked="AutoPreampCheck_Changed"/>
                    <TextBlock x:Name="EffPreampText" Foreground="#6B7A99" FontSize="10" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Foreground="#6B7A99" FontSize="10" TextWrapping="Wrap"
                       Text="Requiere Equalizer APO (gratis). NEXUS.EQ escribe el archivo nexus_eq.txt en su carpeta config y lo enlaza desde config.txt. Activa tu dispositivo de salida en el Configurator de Equalizer APO."/>
        </StackPanel>
    </ScrollViewer>
</Window>
